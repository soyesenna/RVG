{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "One engine trace node; request/response bodies stored separately",
  "required": [
    "run_id",
    "request_id",
    "node_id",
    "parent_ids",
    "operation",
    "attempt_kind",
    "policy_hash",
    "input_hash",
    "output_hash",
    "started_at",
    "ended_at",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": "string",
      "minLength": 1
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_kind": {
      "enum": [
        "original",
        "transport_retry",
        "semantic_retry",
        "partner_draft",
        "repair",
        "replay"
      ]
    },
    "status": {
      "enum": [
        "OK",
        "REFUSED",
        "TIMEOUT",
        "SCHEMA_ERROR",
        "CANCELLED",
        "ERROR"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "acl_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provider_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reported_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
