{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "EvidenceUnit: proposed minimal provenance record",
  "required": [
    "tenant_id",
    "document_id",
    "unit_id",
    "revision_id",
    "content_hash",
    "text",
    "source_uri",
    "source_title",
    "section_path",
    "span",
    "family_id",
    "family_provenance",
    "observed_at",
    "published_at",
    "effective_from",
    "effective_to",
    "permission_epoch"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "family_provenance": {
      "enum": [
        "source_revision_lineage",
        "source_document_id",
        "inferred",
        "unknown"
      ]
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "span": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "offset_unit",
        "start",
        "end"
      ],
      "properties": {
        "offset_unit": {
          "enum": [
            "unicode_codepoint",
            "utf8_byte"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "permission_epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
