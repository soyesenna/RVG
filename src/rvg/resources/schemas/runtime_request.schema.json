{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "RuntimeRequest: proposed minimal interface",
  "required": [
    "request_id",
    "tenant_id",
    "principal_id",
    "question",
    "locale",
    "freshness_mode",
    "context"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "freshness_mode": {
      "enum": [
        "as_of_snapshot",
        "latest_at_release"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_context": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
