# RVG runtime settings — an example for standalone use (the `rvg` command line,
# `rvg.load_settings(root)`).
#
# How to use it
# - A library caller (a service, a research harness) does not use this file: it builds
#   `rvg.Settings(...)` from its own configuration and passes it on. `rvg.Settings(...)` reads its
#   arguments and the environment, never a `.env` file.
# - For standalone use, copy this file to `.env` under `--root` (default: the current directory).
#   Nothing is read from the installed package or the source tree. Priority: arguments >
#   environment > `.env` > defaults.
# - Never put real keys in this example or commit them (`.env` is git-ignored).
# - Every commented `# KEY=value` line is the default; uncomment a line only to change it. The
#   policy (thresholds, retrieval) is one file, `rvg/resources/policies/universal.json`, the same
#   for every knowledge base and language.

# Mode: mock | live. mock never calls an external API.
# RVG_MODE and the legacy name DEEPJEV_MODE are the same setting; both with different values in one
# source is an error.
RVG_MODE=mock

# ---- Provider credentials -----------------------------------------------------------------------
# OpenRouter: the Jev judge (default), embeddings, and the writer/extractor when
# PROPOSER_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Only with JEV_PROVIDER=vercel_gateway.
AI_GATEWAY_API_KEY=
# Only with JEV_PROVIDER=typesafe_direct.
# TYPESAFE_API_KEY=

# ---- Jev judge (controller) ---------------------------------------------------------------------
# Provider: openrouter (default: OpenRouter Decisions, typesafe/jev-1.14) | vercel_gateway |
# typesafe_direct | mock
# JEV_PROVIDER=openrouter
# OPENROUTER_JEV_MODEL=typesafe/jev-1.14
# Decisions lives outside /api/v1, so the whole URL is given.
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# With vercel_gateway or typesafe_direct: the model, the endpoints, and whether the first HTTP 429
# falls back to OpenRouter. The evaluation adapter appends /evaluation-model (not
# /v1/chat/completions).
# JEV_MODEL=typesafe-ai/jev
# VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
# JEV_FALLBACK_ENABLED=true
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# ---- Embeddings ---------------------------------------------------------------------------------
# Provider: openrouter | mock
# EMBEDDING_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=google/gemini-embedding-2
# Requested dimensions (the response is checked too). 1536 is the measured configuration.
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_ENCODING_FORMAT=float
# Input limit including the prefix. A longer input is split keeping its source spans, never cut.
# EMBEDDING_MAX_INPUT_TOKENS=8192
# Inputs per request; 2 was verified equal to single requests. Verify a larger batch first.
# EMBEDDING_BATCH_SIZE=2
# OpenRouter upstreams to use (comma-separated, e.g. google-ai-studio). Empty: any.
# EMBEDDING_UPSTREAM_ONLY=
# EMBEDDING_NORMALIZE=true
# EMBEDDING_SIMILARITY_METRIC=cosine
# Gemini Embedding 2 takes no input_type; the prefixes below carry the purpose.
# EMBEDDING_QUERY_INPUT_TYPE=
# EMBEDDING_DOCUMENT_INPUT_TYPE=
# The prefix runs to the closing quote, trailing space included. Changing it changes the
# embedding space (raise EMBEDDING_SPACE_VERSION too).
# EMBEDDING_QUERY_PREFIX="task: search result | query: "
# EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
# EMBEDDING_SPACE_VERSION=2

# ---- Writer and extractor -----------------------------------------------------------------------
# Provider: claude_code (default) | openrouter | mock
# claude_code runs the Claude Code CLI (`claude -p`) on its logged-in subscription; temperature
# and token limits do not apply. With openrouter, the two models below must be OpenRouter model
# ids (`vendor/model`, e.g. qwen/qwen3.8-27b) — the defaults are Claude Code names.
# PROPOSER_PROVIDER=claude_code
# SEMANTIC_PROPOSER_MODEL=claude-haiku-5-5
# SURFACE_PROPOSER_MODEL=claude-haiku-5-5
# PROPOSER_TEMPERATURE=0
# Leave empty for a model without a reasoning option.
# PROPOSER_REASONING_ENABLED=false
# json_object only for a model without json_schema support.
# PROPOSER_RESPONSE_MODE=json_schema
# SEMANTIC_PROPOSER_MAX_TOKENS=2048
# SURFACE_PROPOSER_MAX_TOKENS=1024

# ---- Request budget (call counts and time per request) ------------------------------------------
# HTTP_TIMEOUT_SECONDS=20
# HTTP_MAX_ATTEMPTS=3
# RUN_DEADLINE_SECONDS=60
# RUN_MAX_JEV_CALLS=12
# RUN_MAX_EMBEDDING_CALLS=4
# RUN_MAX_HTTP_ATTEMPTS=24
# RUN_MAX_GENERATION_CALLS=4
# RUN_MAX_SEMANTIC_PROPOSER_CALLS=2
# RUN_MAX_SURFACE_PROPOSER_CALLS=2
# RUN_MAX_SCHEMA_REPAIRS=1
# Empty: no cost limit. A provider that reports no cost is not counted as zero.
# RUN_MAX_COST_USD=

# ---- Legacy: the grounded path's judgement and retrieval ----------------------------------------
# Not read by the universal engine (`rvg universal-query`, `rvg.open_session`), which takes these
# from the policy file.
# CHOICE_POLICY=probability_margin
# CHOICE_MIN_PROBABILITY=0.6
# CHOICE_MIN_MARGIN=0.15
# CHOICE_MIN_PROVIDER_CONFIDENCE=0.6
# RELEVANCE_THRESHOLD=0.65
# SUPPORT_THRESHOLD=0.85
# RETRIEVAL_MODE=hybrid
# DOCUMENT_SEARCH_STRATEGY=dense
# RETRIEVAL_CANDIDATE_K=16
# RETRIEVAL_EXPANDED_K=32
# RETRIEVAL_RRF_K=60
# EVIDENCE_BATCH_SIZE=8
# MAX_SEMANTIC_ACTIONS=4
# DEEPJEV_TASK=grounded_explain

# ---- Legacy: the local service ------------------------------------------------------------------
# Token -> tenant and permissions (JSON). Not a provider API key.
# SERVICE_TOKENS_JSON=
# SERVICE_REQUESTS_PER_MINUTE=30
# SERVICE_MAX_CONCURRENCY=4

# ---- Research paths (relative to `--root`; the research harness's, not read by the engine) -------
# DEEPJEV_DB_PATH=data/deepjev.sqlite3
# DEEPJEV_RUNS_DIR=runs
# DEEPJEV_VECTOR_DIR=data/vectors/gemini-embedding-2-3072-v2

# ---- Not read from this file --------------------------------------------------------------------
# Real-backend test connections come from the shell environment (pytest reads no .env); without
# them those tests skip and do not count as passed: DEEPJEV_TEST_POSTGRES_DSN,
# DEEPJEV_TEST_PGVECTOR_DSN, DEEPJEV_TEST_QDRANT_URL.
# A deployment's storage is chosen by storage.json; a DSN is read from the environment variable
# that configuration names (examples/storage).
